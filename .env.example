APP_NAME=SignSpeak API
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173
BACKEND_ORIGIN=http://127.0.0.1:8000

# Use PostgreSQL in production. SQLite remains a valid local fallback.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/signspeak

SESSION_SECRET_KEY=change-this-session-secret
OAUTH_SESSION_COOKIE_NAME=signspeak_oauth
APP_SESSION_COOKIE_NAME=signspeak_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_DURATION_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
MEDIA_ROOT=artifacts/uploads

ALPHABET_IMAGE_CHECKPOINT=artifacts/alphabet_frames_v1/best.pt
ALPHABET_LANDMARK_CHECKPOINTS=["artifacts/alphabet_landmarks_v2/best.pt","artifacts/alphabet_landmarks_v3/best.pt"]
ALPHABET_GUIDE_RECORDS_PATH=data/alphabet_landmarks_v2/records.json
ALPHABET_THRESHOLD=0.45
ALPHABET_MIN_MARGIN=0.10

WORD_LANDMARK_CHECKPOINT=artifacts/word_landmarks_v14_ft/best.pt
WORD_SEQUENCE_LENGTH=32
WORD_TOP_K=5
WORD_MIN_VALID_FRAME_RATIO=0.35
WORD_CONFIDENCE_THRESHOLD=0.45
WORD_MIN_MARGIN=0.08
WORD_MIRROR_TTA=true
